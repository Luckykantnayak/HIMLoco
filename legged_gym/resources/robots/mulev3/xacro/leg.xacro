<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="leg" params="name mirror mirror_stl front_back front_back_stl">

        <!-- abd_joint -->
        <joint name="${name}_abd_joint" type="revolute">
            <xacro:if value="${name == 'fl'}">
                <origin 
                    xyz="${abd_joint_origin_x} ${abd_joint_origin_y} ${abd_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'fr'}">
                <origin 
                    xyz="${abd_joint_origin_x} ${-1*abd_joint_origin_y} ${abd_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'bl'}">
                <origin 
                    xyz="${-1*abd_joint_origin_x} ${abd_joint_origin_y} ${abd_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'br'}">
                <origin 
                    xyz="${-1*abd_joint_origin_x} ${-1*abd_joint_origin_y} ${abd_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <parent link="base_link"/>
            <child link="${name}_hip_link"/>
            <xacro:if value="${front_back_stl == True}">
                <axis xyz="1 0 0"/>
            </xacro:if>
            <xacro:if value="${front_back_stl == False}">
                <axis xyz="-1 0 0"/>
            </xacro:if>
            <limit 
                lower="${abd_joint_position_min}"
                upper="${abd_joint_position_max}"
                effort="${abd_joint_max_effort}"
                velocity="${abd_joint_max_velocity}"/>
        </joint>

        <!-- hip_link -->
        <link name="${name}_hip_link">
            <inertial>
                <origin 
                    xyz="${hip_link_com_x*front_back} ${hip_link_com_y*mirror} ${hip_link_com_z}"
                    rpy="0 0 0"/>
                <mass value="${hip_link_mass}"/>
                <inertia
                    ixx="${hip_link_inertia_ixx}"
                    ixy="${hip_link_inertia_ixy*mirror*front_back}"
                    ixz="${hip_link_inertia_ixz*front_back}"
                    iyy="${hip_link_inertia_iyy}"
                    iyz="${hip_link_inertia_iyz*mirror}"
                    izz="${hip_link_inertia_izz}"/>
            </inertial>
            <visual>
                <xacro:if value="${front_back_stl == True}">
                    <origin
                        xyz="0 0 0"
                        rpy="0 0 0"/>
                </xacro:if>
                <xacro:if value="${front_back_stl == False}">
                    <origin
                        xyz="0 0 0"
                        rpy="0 ${PI} 0"/>
                </xacro:if>
                <xacro:if value="${mirror_stl == False}">
                    <geometry>
                        <mesh filename="${left_hip_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${mirror_stl == True}">
                    <geometry>
                        <mesh filename="${right_hip_link_STL}"/>
                    </geometry>
                </xacro:if>
                <material name="">
                    <color rgba="0.52941 0.54902 0.54902 1"/>
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <xacro:if value="${mirror_stl == False}">
                    <geometry>
                        <mesh filename="${left_hip_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${mirror_stl == True}">
                    <geometry>
                        <mesh filename="${right_hip_link_STL}"/>
                    </geometry>
                </xacro:if>
            </collision>
        </link>

        <!-- hip_joint -->
        <joint name="${name}_hip_joint" type="revolute">
            <xacro:if value="${name == 'fl'}">
                <origin 
                    xyz="${hip_joint_origin_x} ${hip_joint_origin_y} ${hip_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'fr'}">
                <origin 
                    xyz="${hip_joint_origin_x} ${-1*hip_joint_origin_y} ${hip_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'bl'}">
                <origin 
                    xyz="${-1*hip_joint_origin_x} ${hip_joint_origin_y} ${hip_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'br'}">
                <origin 
                    xyz="${-1*hip_joint_origin_x} ${-1*hip_joint_origin_y} ${hip_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <parent link="${name}_hip_link"/>
            <child link="${name}_thigh_link"/>
            <axis xyz="0 1 0"/>
            <limit 
                lower="${hip_joint_position_min}"
                upper="${hip_joint_position_max}"
                effort="${hip_joint_max_effort}"
                velocity="${hip_joint_max_velocity}"/>
        </joint>

        <!-- thigh_link -->
        <link name="${name}_thigh_link">
            <inertial>
                <origin 
                    xyz="${thigh_link_com_x} ${thigh_link_com_y*mirror} ${thigh_link_com_z}"
                    rpy="0 0 0"/>
                <mass value="${thigh_link_mass}"/>
                <inertia
                    ixx="${thigh_link_inertia_ixx}"
                    ixy="${thigh_link_inertia_ixy*mirror}"
                    ixz="${thigh_link_inertia_ixz}"
                    iyy="${thigh_link_inertia_iyy}"
                    iyz="${thigh_link_inertia_iyz*mirror}"
                    izz="${thigh_link_inertia_izz}"/>
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/> 
                <xacro:if value="${name == 'fl'}">
                    <geometry>
                        <mesh filename="${fl_thigh_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${name == 'fr'}">
                    <geometry>
                        <mesh filename="${fr_thigh_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${name == 'bl'}">
                    <geometry>
                        <mesh filename="${bl_thigh_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${name == 'br'}">
                    <geometry>
                        <mesh filename="${br_thigh_link_STL}"/>
                    </geometry>
                </xacro:if>
                <material name="">
                    <color rgba="0.52941 0.54902 0.54902 1"/>
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/> 
                <xacro:if value="${name == 'fl'}">
                    <geometry>
                        <mesh filename="${fl_thigh_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${name == 'fr'}">
                    <geometry>
                        <mesh filename="${fr_thigh_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${name == 'bl'}">
                    <geometry>
                        <mesh filename="${bl_thigh_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${name == 'br'}">
                    <geometry>
                        <mesh filename="${br_thigh_link_STL}"/>
                    </geometry>
                </xacro:if>
            </collision>
        </link>

        <!-- knee_joint -->
        <joint name="${name}_knee_joint" type="revolute">
            <xacro:if value="${name == 'fl'}">
                <origin 
                    xyz="${knee_joint_origin_x} ${knee_joint_origin_y} ${knee_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'fr'}">
                <origin 
                    xyz="${knee_joint_origin_x} ${-1*knee_joint_origin_y} ${knee_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'bl'}">
                <origin 
                    xyz="${-1*knee_joint_origin_x} ${knee_joint_origin_y} ${knee_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <xacro:if value="${name == 'br'}">
                <origin 
                    xyz="${-1*knee_joint_origin_x} ${-1*knee_joint_origin_y} ${knee_joint_origin_z}" 
                    rpy="0 0 0"/>
            </xacro:if>
            <parent link="${name}_thigh_link"/>
            <child link="${name}_shank_link"/>
            <axis xyz="0 1 0"/>
            <limit 
                lower="${knee_joint_position_min}"
                upper="${knee_joint_position_max}"
                effort="${knee_joint_max_effort}"
                velocity="${knee_joint_max_velocity}"/>
        </joint>

        <!-- shank_link -->
        <link name="${name}_shank_link">
            <inertial>
                <origin 
                    xyz="${shank_link_com_x} ${shank_link_com_y} ${shank_link_com_z}"
                    rpy="0 0 0"/>
                <mass value="${shank_link_mass}"/>
                <inertia
                    ixx="${shank_link_inertia_ixx}"
                    ixy="${shank_link_inertia_ixy}"
                    ixz="${shank_link_inertia_ixz}"
                    iyy="${shank_link_inertia_iyy}"
                    iyz="${shank_link_inertia_iyz}"
                    izz="${shank_link_inertia_izz}"/>
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <xacro:if value="${mirror_stl == False}">
                    <geometry>
                        <mesh filename="${left_shank_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${mirror_stl == True}">
                    <geometry>
                        <mesh filename="${right_shank_link_STL}"/>
                    </geometry>
                </xacro:if>
                <material name="">
                    <color rgba="0.52941 0.54902 0.54902 1"/>
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>
                <xacro:if value="${mirror_stl == False}">
                    <geometry>
                        <mesh filename="${left_shank_link_STL}"/>
                    </geometry>
                </xacro:if>
                <xacro:if value="${mirror_stl == True}">
                    <geometry>
                        <mesh filename="${right_shank_link_STL}"/>
                    </geometry>
                </xacro:if>
            </collision>
        </link>

    </xacro:macro>

</robot>