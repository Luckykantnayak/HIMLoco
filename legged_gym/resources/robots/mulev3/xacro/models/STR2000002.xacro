<?xml version="1_0"?>

<robot xmlns:xacro="http://www_ros_org/wiki/xacro">
    <!-- min-max section start -->

    <xacro:property name="abd_min" value="-1.5708"/>
    <xacro:property name="abd_max" value="1.5708"/>

    <xacro:property name="hip_min" value="-1.5708"/>
    <xacro:property name="hip_max" value="3.14159"/>

    <xacro:property name="knee_min" value="-3.14159"/>
    <xacro:property name="knee_max" value="0"/>

    <!-- min-max section end -->

    <!-- max effort section start -->

    <xacro:property name="abd_max_effort" value="30"/>
    <xacro:property name="hip_max_effort" value="30"/>
    <xacro:property name="knee_max_effort" value="30"/>

    <!-- max effort section end -->
    
    <!-- actuator ids start -->

    <!-- fl actuator ids -->
    <xacro:property name="fl_abd_actuator_id" value="11"/>
    <xacro:property name="fl_hip_actuator_id" value="12"/>
    <xacro:property name="fl_knee_actuator_id" value="13"/>

    <!-- fr actuator ids -->
    <xacro:property name="fr_abd_actuator_id" value="21"/>
    <xacro:property name="fr_hip_actuator_id" value="22"/>
    <xacro:property name="fr_knee_actuator_id" value="23"/>

    <!-- bl actuator ids -->
    <xacro:property name="bl_abd_actuator_id" value="31"/>
    <xacro:property name="bl_hip_actuator_id" value="32"/>
    <xacro:property name="bl_knee_actuator_id" value="33"/>

    <!-- br actuator ids -->
    <xacro:property name="br_abd_actuator_id" value="41"/>
    <xacro:property name="br_hip_actuator_id" value="42"/>
    <xacro:property name="br_knee_actuator_id" value="43"/>

    <!-- actuator ids end -->

    <!-- communication buses start -->

    <xacro:property name="fl_communication_bus" value="can0"/>
    <xacro:property name="fr_communication_bus" value="can1"/>
    <xacro:property name="bl_communication_bus" value="can2"/>
    <xacro:property name="br_communication_bus" value="can3"/>

    <!-- communication buses end -->

    <!-- actuator directions start -->

    <!-- fl -->
    <xacro:property name="fl_abd_direction" value="-1"/>
    <xacro:property name="fl_hip_direction" value="-1"/>
    <xacro:property name="fl_knee_direction" value="+1"/>

    <!-- fr -->
    <xacro:property name="fr_abd_direction" value="-1"/>
    <xacro:property name="fr_hip_direction" value="+1"/>
    <xacro:property name="fr_knee_direction" value="-1"/>

    <!-- bl -->
    <xacro:property name="bl_abd_direction" value="+1"/>
    <xacro:property name="bl_hip_direction" value="-1"/>
    <xacro:property name="bl_knee_direction" value="+1"/>

    <!-- br -->
    <xacro:property name="br_abd_direction" value="+1"/>
    <xacro:property name="br_hip_direction" value="+1"/>
    <xacro:property name="br_knee_direction" value="-1"/>

    <!-- actuator directions end -->

    <!-- torque directions start -->
    
    <!-- fl -->
    <xacro:property name="fl_abd_torque_direction" value="-1"/>
    <xacro:property name="fl_hip_torque_direction" value="-1"/>
    <xacro:property name="fl_knee_torque_direction" value="-1"/>

    <!-- fr -->
    <xacro:property name="fr_abd_torque_direction" value="-1"/>
    <xacro:property name="fr_hip_torque_direction" value="1"/>
    <xacro:property name="fr_knee_torque_direction" value="-1"/>

    <!-- bl -->
    <xacro:property name="bl_abd_torque_direction" value="-1"/>
    <xacro:property name="bl_hip_torque_direction" value="-1"/>
    <xacro:property name="bl_knee_torque_direction" value="-1"/>

    <!-- br -->
    <xacro:property name="br_abd_torque_direction" value="1"/>
    <xacro:property name="br_hip_torque_direction" value="1"/>
    <xacro:property name="br_knee_torque_direction" value="-1"/>

    <!-- torque directions end -->

    <!-- vel limit start -->

    <!-- fl -->
    <xacro:property name="fl_abd_vel_limit" value="30.0"/>
    <xacro:property name="fl_hip_vel_limit" value="30.0"/>
    <xacro:property name="fl_knee_vel_limit" value="30.0"/>

    <!-- fr -->
    <xacro:property name="fr_abd_vel_limit" value="30.0"/>
    <xacro:property name="fr_hip_vel_limit" value="30.0"/>
    <xacro:property name="fr_knee_vel_limit" value="30.0"/>
    
    <!-- bl -->
    <xacro:property name="bl_abd_vel_limit" value="30.0"/>
    <xacro:property name="bl_hip_vel_limit" value="30.0"/>
    <xacro:property name="bl_knee_vel_limit" value="30.0"/>
    
    <!-- br -->
    <xacro:property name="br_abd_vel_limit" value="30.0"/>
    <xacro:property name="br_hip_vel_limit" value="30.0"/>
    <xacro:property name="br_knee_vel_limit" value="30.0"/>
    
    <!-- vel limit end -->

    <!-- vel integrator gain start -->

    <!-- fl -->
    <xacro:property name="fl_abd_vel_integrator_gain" value="0.33"/>
    <xacro:property name="fl_hip_vel_integrator_gain" value="0.33"/>
    <xacro:property name="fl_knee_vel_integrator_gain" value="0.33"/>

    <!-- fr -->
    <xacro:property name="fr_abd_vel_integrator_gain" value="0.33"/>
    <xacro:property name="fr_hip_vel_integrator_gain" value="0.33"/>
    <xacro:property name="fr_knee_vel_integrator_gain" value="0.33"/>
    
    <!-- bl -->
    <xacro:property name="bl_abd_vel_integrator_gain" value="0.33"/>
    <xacro:property name="bl_hip_vel_integrator_gain" value="0.33"/>
    <xacro:property name="bl_knee_vel_integrator_gain" value="0.33"/>
    
    <!-- br -->
    <xacro:property name="br_abd_vel_integrator_gain" value="0.33"/>
    <xacro:property name="br_hip_vel_integrator_gain" value="0.33"/>
    <xacro:property name="br_knee_vel_integrator_gain" value="0.33"/>

    <!-- vel integrator gain end -->

    <!-- gear ratio start -->

    <!-- fl -->
    <xacro:property name="fl_abd_gear_ratio" value="16.0"/>
    <xacro:property name="fl_hip_gear_ratio" value="16.0"/>
    <xacro:property name="fl_knee_gear_ratio" value="24.0"/>

    <!-- fr -->
    <xacro:property name="fr_abd_gear_ratio" value="16.0"/>
    <xacro:property name="fr_hip_gear_ratio" value="16.0"/>
    <xacro:property name="fr_knee_gear_ratio" value="24.0"/>
    
    <!-- bl -->
    <xacro:property name="bl_abd_gear_ratio" value="16.0"/>
    <xacro:property name="bl_hip_gear_ratio" value="16.0"/>
    <xacro:property name="bl_knee_gear_ratio" value="24.0"/>
    
    <!-- br -->
    <xacro:property name="br_abd_gear_ratio" value="16.0"/>
    <xacro:property name="br_hip_gear_ratio" value="16.0"/>
    <xacro:property name="br_knee_gear_ratio" value="24.0"/>

    <!-- gear ratio end -->

    <!-- joint offsets start -->

    <!-- Front Left -->
    <!-- <xacro:property name="fl_abd_offset" value="0.0"/> -->
    <xacro:property name="fl_abd_offset" value="0.047"/>
    <!-- <xacro:property name="fl_abd_offset" value="0.071"/> -->
    <!-- <xacro:property name="fl_abd_offset" value="0.346"/> -->
    
    <!-- <xacro:property name="fl_hip_offset" value="0.0"/> -->
    <!-- <xacro:property name="fl_hip_offset" value="-1.291"/> -->
    <xacro:property name="fl_hip_offset" value="-1.641"/>
    <!-- <xacro:property name="fl_hip_offset" value="-1.322"/> -->
    <!-- <xacro:property name="fl_hip_offset" value="-1.399"/> -->
    <!-- <xacro:property name="fl_hip_offset" value="-1.70"/> -->
    
    <!-- <xacro:property name="fl_knee_offset" value="0.0"/> -->
    <xacro:property name="fl_knee_offset" value="2.883"/>
    <!-- <xacro:property name="fl_knee_offset" value="1.330"/> -->
    <!-- <xacro:property name="fl_knee_offset" value="2.989"/> -->
    <!-- <xacro:property name="fl_knee_offset" value="2.747"/> -->
    <!-- <xacro:property name="fl_knee_offset" value="3.005"/> -->

    <!-- Front Right -->
    <!-- <xacro:property name="fr_abd_offset" value="0.0"/> -->
    <xacro:property name="fr_abd_offset" value="-0.067"/>
    <!-- <xacro:property name="fr_abd_offset" value="-0.067"/> -->
    <!-- <xacro:property name="fr_abd_offset" value="-0.315"/> -->
    <!-- <xacro:property name="fr_abd_offset" value="0.038"/> -->
    <!-- <xacro:property name="fr_abd_offset" value="-0.353"/> -->
    <!-- <xacro:property name="fr_abd_offset" value="0.043"/> -->

    <!-- <xacro:property name="fr_hip_offset" value="0.0"/> -->
    <xacro:property name="fr_hip_offset" value="-1.578"/>
    <!-- <xacro:property name="fr_hip_offset" value="0.534"/> -->
    <!-- <xacro:property name="fr_hip_offset" value="-1.269"/> -->
    <!-- <xacro:property name="fr_hip_offset" value="-1.760"/> -->
    <!-- <xacro:property name="fr_hip_offset" value="-1.35"/> -->

    <!-- <xacro:property name="fr_knee_offset" value="0.0"/> -->
    <xacro:property name="fr_knee_offset" value="2.961"/>
    <!-- <xacro:property name="fr_knee_offset" value="2.946"/> -->
    <!-- <xacro:property name="fr_knee_offset" value="2.923"/> -->
    <!-- <xacro:property name="fr_knee_offset" value="2.928"/> -->

    <!-- Back Left -->
    <!-- <xacro:property name="bl_abd_offset" value="0.0"/> -->
    <xacro:property name="bl_abd_offset" value="0.173"/>
    <!-- <xacro:property name="bl_abd_offset" value="0.173"/> -->
    <!-- <xacro:property name="bl_abd_offset" value="-0.029"/> -->

    <!-- <xacro:property name="bl_hip_offset" value="0.0"/> -->
    <xacro:property name="bl_hip_offset" value="-1.366"/>
    <!-- <xacro:property name="bl_hip_offset" value="-1.361"/> -->
    <!-- <xacro:property name="bl_hip_offset" value="-1.341"/> -->
    <!-- <xacro:property name="bl_hip_offset" value="-1.419"/> -->

    <!-- <xacro:property name="bl_knee_offset" value="0.0"/> -->
    <xacro:property name="bl_knee_offset" value="2.893"/>
    <!-- <xacro:property name="bl_knee_offset" value="0.704"/> -->
    <!-- <xacro:property name="bl_knee_offset" value="2.910"/> -->
