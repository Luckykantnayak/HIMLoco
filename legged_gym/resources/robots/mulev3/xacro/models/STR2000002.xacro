    <!-- Back Right -->
    <!-- <xacro:property name="br_abd_offset" value="0.0"/> -->
    <xacro:property name="br_abd_offset" value="-0.220"/>
    <!-- <xacro:property name="br_abd_offset" value="-0.220"/> -->
    <!-- <xacro:property name="br_abd_offset" value="-0.209"/> -->

    <!-- <xacro:property name="br_hip_offset" value="0.0"/> -->
    <xacro:property name="br_hip_offset" value="-1.417"/>
    <!-- <xacro:property name="br_hip_offset" value="-1.417"/> -->
    <!-- <xacro:property name="br_hip_offset" value="0.355"/> -->
    <!-- <xacro:property name="br_hip_offset" value="-1.475"/> -->
    <!-- <xacro:property name="br_hip_offset" value="-1.680"/> -->

    <!-- <xacro:property name="br_knee_offset" value="0.0"/> -->
    <xacro:property name="br_knee_offset" value="2.951"/>
